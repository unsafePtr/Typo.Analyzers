<Project>

  <PropertyGroup>
    <!-- The SDK sets no WarningLevel for netstandard2.0, so the compiler would leave out every warning wave since C# 9. -->
    <WarningLevel>9999</WarningLevel>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Enforces the .editorconfig rules in the command-line build, not only in the IDE.
    Without AnalysisLevel the build ignores the severity suffix of an option such as csharp_style_var_elsewhere = true:error.
    AnalysisLevel also turns on the CA rules, which are off by default for netstandard2.0.
    IDE0005 runs on build only with a documentation file.
    CS1591 and CS1573 are silenced because a doc comment covers only what the code cannot say, not every member or parameter.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

</Project>
